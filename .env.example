# Local development (docker compose up -d). Production values live in Vercel and GitHub
# environment secrets, never in this file or in git. See docs/deploy.md.

# Runtime connection. Locally: the compose database. In production: Supabase's transaction
# pooler (port 6543) as the least-privilege login, e.g.
# postgresql://app_runtime.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/predev"

# Supabase's CA certificate (PEM; literal \n escapes are accepted). Required for any remote host.
DATABASE_CA_CERT=""

# Optional: connections per server instance (default 3).
# DATABASE_POOL_MAX=3

# CI only (never in Vercel): the schema owner's direct connection, used by prisma migrate deploy.
# MIGRATION_DATABASE_URL=""

# Optional overrides for tests.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/predev_e2e"

ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
